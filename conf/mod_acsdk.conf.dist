#
# mod-acsdk configuration (PLAN.md §8)
#
# Copy to mod_acsdk.conf next to worldserver.conf (configs/modules/).
#
# SDK clients log in with ordinary AzerothCore game accounts (create one with the GM/console command
# ".account create <name> <password>"). A session may only see and drive characters on its own account.
#

[worldserver]

#
#    ACSDK.Enable
#        Description: Enable the SDK gRPC listener.
#        Default:     1
#

ACSDK.Enable = 1

#
#    ACSDK.BindAddress / ACSDK.Port
#        Description: Listen address for the gRPC server. The transport has no TLS yet, so the listener
#                     refuses to start on anything but a loopback address (127.x.x.x, ::1, localhost).
#        Default:     "127.0.0.1" / 50051
#

ACSDK.BindAddress = "127.0.0.1"
ACSDK.Port = 50051

#
#    ACSDK.Auth.AllowGmAccounts
#        Description: Let accounts with a GM level (account_access.gmlevel > 0) log in to the SDK.
#                     Off by default: SDK sessions are for player accounts. An admin session (below)
#                     needs this on. GM accounts still cannot log characters in headless.
#        Default:     0
#

ACSDK.Auth.AllowGmAccounts = 0

#
#    ACSDK.Auth.AdminGmLevel
#        Description: Sessions of accounts at or above this GM level are admin: they may call
#                     ServerService.GetStats and DebugService and use the ".acsdk session" commands'
#                     RPC equivalents. Admin never grants access to other accounts' characters.
#                     Only takes effect with ACSDK.Auth.AllowGmAccounts = 1.
#        Default:     3
#

ACSDK.Auth.AdminGmLevel = 3

#
#    ACSDK.Auth.SessionIdleSec / ACSDK.Auth.SessionMaxSec
#        Description: A session ends after SessionIdleSec without a call (sliding), and in any case
#                     SessionMaxSec after login. Its leases are then released (LeaseLost SESSION_ENDED)
#                     and its event streams end; its characters stay logged in.
#        Default:     1800 / 86400
#

ACSDK.Auth.SessionIdleSec = 1800
ACSDK.Auth.SessionMaxSec = 86400

#
#    ACSDK.Auth.RecheckSec
#        Description: How often live sessions are checked against the auth database. A session ends
#                     when its account is deleted, banned, locked, changes password or GM level, or no
#                     longer matches ACSDK.HeadlessAccountPrefix.
#        Default:     60
#

ACSDK.Auth.RecheckSec = 60

#
#    ACSDK.AuthToken
#        Description: Removed in 1.1.0 (shared server token). Ignored, with a warning at startup.
#

#
#    ACSDK.MaxCommandsPerTick / ACSDK.MaxTickBudgetMs
#        Description: Upper bounds on SDK work done on the world thread per tick. Excess stays
#                     queued for the next tick.
#        Default:     200 / 5
#

ACSDK.MaxCommandsPerTick = 200
ACSDK.MaxTickBudgetMs = 5

#
#    ACSDK.CommandQueueSize
#        Description: Maximum queued world-thread commands. When full, new RPCs fail with
#                     RESOURCE_EXHAUSTED.
#        Default:     4096
#

ACSDK.CommandQueueSize = 4096

#
#    ACSDK.HeadlessAccountPrefix
#        Description: Extra server-wide gate: only accounts whose username starts with this prefix
#                     (case-insensitive) may log in to the SDK or have characters driven headless.
#                     Empty = any account. (Before 1.1.0, empty meant none.)
#        Default:     "acsdkhc"
#

ACSDK.HeadlessAccountPrefix = "acsdkhc"

#
#    ACSDK.MaxListResults
#        Description: Cap on characters returned by CharacterService.List.
#        Default:     1000
#

ACSDK.MaxListResults = 1000

#
#    ACSDK.MaxHeadlessCharacters
#        Description: Maximum characters logged in headless at once.
#        Default:     50
#

ACSDK.MaxHeadlessCharacters = 50

#
#    ACSDK.Reflex.TeleportAck
#        Description: Automatically send the far/near teleport acknowledgements a client would,
#                     so a teleported headless character is not stuck (PLAN.md §5.2).
#        Default:     1
#

ACSDK.Reflex.TeleportAck = 1

#
#    ACSDK.PacketSinkSize
#        Description: Captured server packets kept per headless character (oldest dropped first).
#        Default:     256
#

ACSDK.PacketSinkSize = 256

#
#    ACSDK.Debug.Enable
#        Description: Serve the dev-only DebugService (creates test accounts and characters) to admin
#                     sessions. Development only.
#        Default:     0
#

ACSDK.Debug.Enable = 0

#
#    ACSDK.Reflex.Knockback
#        Description: Move a knocked-back headless character server-side with AzerothCore's own
#                     knockback (a client would simulate the arc itself).
#        Default:     1
#

ACSDK.Reflex.Knockback = 1

#
#    ACSDK.EventQueueSize
#        Description: Events buffered per Subscribe stream. A slow subscriber loses the oldest events
#                     and is sent Lagged{dropped=N}; the world thread never waits for it.
#        Default:     4096
#

ACSDK.EventQueueSize = 4096

#
#    ACSDK.Prompt.TimeoutSec
#        Description: Unanswered prompts (group invite, trade, duel, resurrect, summon, loot roll,
#                     ready check) are declined / passed after this many seconds.
#        Default:     60
#

ACSDK.Prompt.TimeoutSec = 60

#
#    ACSDK.RawPackets.Enable / .Allow / .PerSecond
#        Description: Escape hatch (PLAN.md §4.6.4): ActionService.SendClientPacket and RAW_PACKET events.
#                     Allow = comma-separated client opcodes (e.g. 0x06E); empty = any handled opcode
#                     except the fixed login/character-management denylist. PerSecond = per character.
#        Default:     0 / "" / 20
#

ACSDK.RawPackets.Enable = 0
ACSDK.RawPackets.Allow = ""
ACSDK.RawPackets.PerSecond = 20
